    <ns0:Executable ns0:refId="Package\Prepare Staging Tables" ns0:CreationName="Microsoft.ExecuteSQLTask" ns0:Description="Execute SQL Task" ns0:DTSID="{02CF99FD-8DA3-4194-A42C-EB4EB2BC8F97}" ns0:ExecutableType="Microsoft.ExecuteSQLTask" ns0:LocaleID="-1" ns0:ObjectName="Prepare Staging Tables" ns0:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" ns0:ThreadHint="0">
      <ns0:Variables />
      <ns0:ObjectData>
        <ns1:SqlTaskData ns1:SqlStatementSource="USE DW_Football_Analytics;&#10;&#10;-- Nếu chưa có bảng Staging thì tự động TẠO MỚI, nếu đã có thì XÓA DỮ LIỆU CŨ (TRUNCATE)&#10;IF OBJECT_ID('dbo.STG_Appearances', 'U') IS NULL&#10;BEGIN&#10;    CREATE TABLE dbo.STG_Appearances (&#10;        appearance_id VARCHAR(100),&#10;        game_id INT,&#10;        player_id INT,&#10;        player_club_id INT,&#10;        player_current_club_id INT,&#10;        date_str VARCHAR(50),&#10;        player_name NVARCHAR(250),&#10;        competition_id VARCHAR(50),&#10;        yellow_cards INT,&#10;        red_cards INT,&#10;        goals INT,&#10;        assists INT,&#10;        minutes_played INT&#10;    );&#10;END&#10;ELSE&#10;BEGIN&#10;    TRUNCATE TABLE dbo.STG_Appearances;&#10;END" ns1:Connection="{403FDCE3-ADB4-52C8-9E50-1F2358DD5DCE}" />
      </ns0:ObjectData>
    </ns0:Executable>
  <ns0:Executable ns0:refId="Package\Populate FACT via SQL Join" ns0:CreationName="Microsoft.ExecuteSQLTask" ns0:DTSID="{7E2A91D3-48F1-4B9E-8B52-9A83F17C218B}" ns0:ExecutableType="Microsoft.ExecuteSQLTask" ns0:LocaleID="-1" ns0:ObjectName="Populate FACT via SQL Join" ns0:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"><ns0:ObjectData><ns1:SqlTaskData ns1:Connection="{403FDCE3-ADB4-52C8-9E50-1F2358DD5DCE}" ns1:SqlStatementSource="USE DW_Football_Analytics;&#10;&#10;TRUNCATE TABLE dbo.FACT_Player_Match_Perf;&#10;&#10;INSERT INTO dbo.FACT_Player_Match_Perf (&#10;    Player_SK,&#10;    Club_SK,&#10;    Opponent_Club_SK,&#10;    Competition_SK,&#10;    Game_SK,&#10;    Time_SK,&#10;    Game_ID,&#10;    Minutes_Played,&#10;    Goals,&#10;    Assists,&#10;    Goal_Contributions,&#10;    Yellow_Cards,&#10;    Red_Cards,&#10;    Is_Starter&#10;)&#10;SELECT &#10;    ISNULL(p.Player_SK, 1),&#10;    ISNULL(c.Club_SK, 1),&#10;    ISNULL(c.Club_SK, 1) AS Opponent_Club_SK,&#10;    ISNULL(comp.Competition_SK, 1) AS Competition_SK,&#10;    ISNULL(g.Game_SK, 1) AS Game_SK,&#10;    1 AS Time_SK,&#10;    s.game_id,&#10;    ISNULL(s.minutes_played, 0),&#10;    ISNULL(s.goals, 0),&#10;    ISNULL(s.assists, 0),&#10;    (ISNULL(s.goals, 0) + ISNULL(s.assists, 0)) AS Goal_Contributions,&#10;    ISNULL(s.yellow_cards, 0),&#10;    ISNULL(s.red_cards, 0),&#10;    CASE WHEN ISNULL(s.minutes_played, 0) &gt;= 60 THEN 1 ELSE 0 END AS Is_Starter&#10;FROM dbo.STG_Appearances s&#10;LEFT JOIN dbo.DIM_Player p ON s.player_id = p.Player_ID&#10;LEFT JOIN dbo.DIM_Club c ON s.player_club_id = c.Club_ID&#10;LEFT JOIN dbo.DIM_Competition comp ON s.competition_id = comp.Competition_ID&#10;LEFT JOIN dbo.DIM_Game g ON s.game_id = g.Game_ID;&#10;" /></ns0:ObjectData></ns0:Executable></ns0:Executables>
