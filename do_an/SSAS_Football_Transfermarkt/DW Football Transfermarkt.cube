  <MdxScripts>
    <MdxScript dwd:design-time-name="51d6a1de-31ce-4aa9-99b3-1896cb910c54">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 

-- Named Set cho Query 10: Top 10 CLB ghi bàn nhiều nhất năm 2023
CREATE DYNAMIC SET CURRENTCUBE.[Top 10 Clubs 2023]
 AS TOPCOUNT(
    NONEMPTY(
        EXCEPT([DIM Club].[Club Name].[Club Name].MEMBERS, { [DIM Club].[Club Name].[All] }),
        ([Measures].[Goals], [DIM Time].[Hierarchy].[Year].[2023])
    ),
    10,
    ([Measures].[Goals], [DIM Time].[Hierarchy].[Year].[2023])
); 

-- Thước đo cho Query 10: Tăng trưởng bàn thắng theo Quý (QoQ)
CREATE MEMBER CURRENTCUBE.[Measures].[QoQ Goals Growth]
 AS IIF(
    [DIM Time].[Hierarchy].CURRENTMEMBER.LEVEL IS [DIM Time].[Hierarchy].[Quarter]
    AND [DIM Time].[Hierarchy].CURRENTMEMBER.PREVMEMBER.PARENT IS [DIM Time].[Hierarchy].CURRENTMEMBER.PARENT
    AND NOT ISEMPTY(([Measures].[Goals], [DIM Time].[Hierarchy].CURRENTMEMBER.PREVMEMBER))
    AND ([Measures].[Goals], [DIM Time].[Hierarchy].CURRENTMEMBER.PREVMEMBER) &lt;&gt; 0,
    ([Measures].[Goals] - ([Measures].[Goals], [DIM Time].[Hierarchy].CURRENTMEMBER.PREVMEMBER))
        / ([Measures].[Goals], [DIM Time].[Hierarchy].CURRENTMEMBER.PREVMEMBER),
    NULL
), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT Player Match Perf'; 

-- Thước đo cho Query 11: Sức chứa sân vận động chuẩn hóa
CREATE MEMBER CURRENTCUBE.[Measures].[Stadium Capacity Cleaned]
 AS COALESCEEMPTY(
    MAX(
        EXISTING [DIM Club].[Stadium Seats].[Stadium Seats].MEMBERS,
        [DIM Club].[Stadium Seats].CURRENTMEMBER.MEMBER_VALUE
    ),
    0
), 
FORMAT_STRING = "#,##0 Chỗ", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT Player Match Perf'; 

-- Thước đo cho Query 11: Đếm số trận đấu duy nhất
CREATE MEMBER CURRENTCUBE.[Measures].[Distinct Matches Played]
 AS DISTINCTCOUNT(
    EXISTING [DIM Game].[Game ID].[Game ID].MEMBERS
), 
FORMAT_STRING = "#,##0", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT Player Match Perf'; 

-- Thước đo cho Query 04: Số phút thi đấu trung bình mỗi trận
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Minutes Played]
 AS IIF(
    IsEmpty([Measures].[FACT Player Match Perf Count]) OR [Measures].[FACT Player Match Perf Count] = 0,
    NULL,
    ROUND([Measures].[Minutes Played] / [Measures].[FACT Player Match Perf Count], 2)
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT Player Match Perf'; 

-- Thước đo cho Query 07: Tỷ lệ phần trăm đóng góp bàn thắng giải đấu tại Anh
CREATE MEMBER CURRENTCUBE.[Measures].[Pct Of England Goals]
 AS IIF(
    IsEmpty(([Measures].[Goals], [DIM Player].[Country Of Citizenship].[All])) 
    OR ([Measures].[Goals], [DIM Player].[Country Of Citizenship].[All]) = 0,
    NULL,
    [Measures].[Goals] / ([Measures].[Goals], [DIM Player].[Country Of Citizenship].[All])
), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT Player Match Perf'; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>